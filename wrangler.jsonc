// Cloudflare Worker「11ai」：只托管 npm run build 生成的 dist/ 静态文件。
// 主域名 11aike.com；www.11aike.com 和旧域名 11edu.cc 也挂在这里，由 Cloudflare 跳转规则 301 到 https://11aike.com（见 docs/cloudflare-deployment.md）
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "11ai",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "11aike.com", "custom_domain": true },
    { "pattern": "www.11aike.com", "custom_domain": true },
    { "pattern": "11edu.cc", "custom_domain": true }
  ],
  "workers_dev": true,
  // 不给每次上传的版本单独生成预览网址（Cloudflare 不会自动清理，会越积越多）。要预览就用下面的 preview 环境
  "preview_urls": false,
  "observability": { "enabled": true },
  "env": {
    // 预览专用：npx wrangler deploy --env preview → 固定网址 https://11ai-preview.xinqianqian951210.workers.dev ，每次覆盖，不挂正式域名
    "preview": {
      "name": "11ai-preview",
      "routes": [],
      "workers_dev": true,
      "preview_urls": false
    }
  }
}
