---
/* 首页 */
import '../styles/tokens.css';
import '../styles/home.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Hero from '../components/home/Hero.astro';
import CatalogSection from '../components/home/CatalogSection.astro';
import WorksSection from '../components/home/WorksSection.astro';
import { SITE } from '../site.config';
import { website, person } from '../lib/seo';
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <Seo title={SITE.homeTitle} description={SITE.description} jsonLd={[website(), { '@context': 'https://schema.org', ...person() }]} />
</head>
<body>
  <Header />
  <Hero />
  <CatalogSection />
  <WorksSection />
</body>
</html>
