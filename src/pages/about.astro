---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import DocPage from '../components/DocPage.astro';
import { person, abs } from '../lib/seo';
import { SITE } from '../site.config';
const page = (await getEntry('pages', 'about'))!;
const { Content, headings } = await render(page);
const ld = { '@context': 'https://schema.org', '@type': 'AboutPage', url: abs('/about/'), name: page.data.标题, mainEntity: person() };
---
<PageLayout title={page.data.标题} description={page.data.简介} jsonLd={[ld]}>
  <DocPage title={page.data.标题} icon="o09" headings={headings} byline={`${SITE.author.name} · ${SITE.author.location}`}>
    <Content />
  </DocPage>
</PageLayout>
