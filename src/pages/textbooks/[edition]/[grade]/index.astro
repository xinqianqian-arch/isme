---
import PageLayout from '../../../../layouts/PageLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import GradeCard from '../../../../components/GradeCard.astro';
import { getCatalog, CN } from '../../../../lib/catalog';

export async function getStaticPaths() {
  const { grades } = await getCatalog();
  return grades.map(g => ({ params: { edition: g.edition.slug, grade: `grade-${g.grade}` }, props: { g } }));
}
const { g } = Astro.props;
const n = CN[g.grade], e = g.edition;
const both = g.books.length > 1;
---
<PageLayout title={`${e.name}${n}年级数学${both ? '上下册' : g.books[0].volumeName}教材目录`} description={`${e.name}小学${n}年级数学${both ? '上册、下册' : g.books[0].volumeName}单元目录，提供教学重点、易错点与课堂活动建议。`}>
  <Breadcrumb items={[{ name: e.name, url: `/textbooks/${e.slug}/` }, { name: `${n}年级` }]} />
  <PageHero eyebrow={`${e.name} · ${n}年级`} title={`小学${n}年级数学同步目录`} lead={`选择${both ? '上册或下册' : g.books[0].volumeName}，查看单元知识与教学建议。教材修订后单元安排可能发生变化，以您正在使用的教材印次为准。`} />
  <div class="cards">
    {g.books.map(b => <GradeCard href={b.url} img={`g${g.grade}${b.volume === 1 ? 'b' : 'c'}`} tiny={b.revision} title={b.volumeName} text={`${b.units.length} 个主要学习单元 · 教学内容介绍`} more={`进入${b.volumeName} →`} />)}
  </div>
</PageLayout>
