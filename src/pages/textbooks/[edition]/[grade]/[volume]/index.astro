---
/* 全册目录：所有单元和课一页看全。左边单元导航，右边每个单元列出课；有完整备课的课带插画、知识点和页码 */
import PageLayout from '../../../../../layouts/PageLayout.astro';
import CatalogHero from '../../../../../components/CatalogHero.astro';
import Breadcrumb from '../../../../../components/Breadcrumb.astro';
import LessonGrid from '../../../../../components/LessonGrid.astro';
import XhsCta from '../../../../../components/XhsCta.astro';
import { getCatalog, CN, bookImage, type Book, type Unit } from '../../../../../lib/catalog';
import { media } from '../../../../../lib/media.mjs';
import { toneVars } from '../../../../../lib/tones';

export async function getStaticPaths() {
  const { books } = await getCatalog();
  return books.map(b => ({ params: { edition: b.edition.slug, grade: `grade-${b.grade}`, volume: `volume-${b.volume}` }, props: { b, siblings: books.filter(x => x.edition === b.edition) } }));
}
const { b, siblings } = Astro.props as { b: Book; siblings: Book[] };
const n = CN[b.grade], e = b.edition;
const all = b.units.flatMap(u => u.lessons);
const doneOf = (x: Book) => x.units.reduce((k, u) => k + u.lessons.filter(l => l.indexable).length, 0);
const done = doneOf(b);
/** 单元封面：这个单元里任一课写了“封面”就用它 */
const coverOf = (u: Unit) => u.lessons.find(l => l.entry?.data.封面)?.entry?.data.封面;
---
<PageLayout title={`${e.name}${n}年级数学${b.volumeName}教材目录｜单元知识点`} description={`${e.name}${n}年级数学${b.volumeName}课程目录，含${b.units.length}个学习单元的知识重点、教学重难点、课堂活动及课时导航。`}>
  <Breadcrumb items={[{ name: e.name, url: `/textbooks/${e.slug}/` }, { name: `${n}年级`, url: `/textbooks/${e.slug}/grade-${b.grade}/` }, { name: b.volumeName }]} />
  <CatalogHero eyebrow={`${e.name} · ${b.revision}`} title={`${n}年级数学${b.volumeName}课程目录`} lead={`本册 ${b.units.length} 个单元、${all.length} 课，一页看全，点课题直接进入。${done > 0 ? '带插画的课有完整备课：教材解读、教学设计、趣味活动和 AI 提示词。' : ''}`} img={bookImage(b) ?? media(`courseware/covers/g${b.grade}a.webp`)} stickers={['n07', 'o02', 'n09']} tone={toneVars(b.grade)}>
    <div class="ch-stats"><span>📖 {b.units.length} 个单元</span><span>📝 {all.length} 课</span>{done > 0 && <span class="hot">✨ {done} 课完整备课</span>}</div>
    <p class="ch-note">教材版本：{b.revision}。<a href="/articles/textbook-edition-guide/">如何辨别新旧教材？</a></p>
  </CatalogHero>
  <nav class="book-switch" aria-label="切换年级和册">
    {siblings.map(s => s === b
      ? <span>{CN[s.grade]}{s.volumeName[0]}</span>
      : <a class:list={[{ hot: doneOf(s) > 0 }]} href={s.url}>{CN[s.grade]}{s.volumeName[0]}</a>)}
  </nav>
  <div class="book-layout">
    <aside class="book-nav" aria-label="本册单元">
      <p>单元</p>
      <ol>{b.units.map(u => <li style={toneVars(u.order)}><a href={`#${u.id}`}><b>{u.order}</b>{u.title}<small>{u.lessons.length} 课</small></a></li>)}</ol>
    </aside>
    <div>
      {b.units.map(u => {
        const cover = coverOf(u);
        return (
          <section class="bunit" id={u.id} style={toneVars(u.order)}>
            <header class="bunit-head">
              <span class="unit-no">{String(u.order).padStart(2, '0')}</span>
              <div>
                <h2><a href={u.url}>{u.title}</a></h2>
                <p>{u.focus}</p>
                <a class="more" href={u.url}>单元要点 →</a>
              </div>
              {cover && <a class="bunit-cover" href={u.url} tabindex="-1" aria-hidden="true"><img src={cover} alt="" loading="lazy"></a>}
            </header>
            <LessonGrid lessons={u.lessons} />
          </section>
        );
      })}
    </div>
  </div>
  <XhsCta title="本册互动课件" text={`${n}年级${b.volumeName}各单元的动画演示、课堂互动与练习设计，在十一课件的小红书主页持续更新。`} />
</PageLayout>
