---
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import GradeCard from '../../../components/GradeCard.astro';
import { getCatalog, CN } from '../../../lib/catalog';
import { abs } from '../../../lib/seo';

export async function getStaticPaths() {
  const { editions } = await getCatalog();
  return editions.map(x => ({ params: { edition: x.edition.slug }, props: { x } }));
}
const { x } = Astro.props;
const e = x.edition;
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${e.name}小学数学课程目录`, url: abs(x.url), inLanguage: 'zh-CN' };
---
<PageLayout title={`${e.name}小学数学1—6年级课件目录与备课指南`} description={`${e.name}小学数学上下册课程导航：分年级查找真实单元目录、教学内容、易错点和互动课件更新。`} jsonLd={[ld]}>
  <Breadcrumb items={[{ name: '教材目录', url: '/textbooks/' }, { name: e.name }]} />
  <PageHero eyebrow={`${e.name} · 小学数学`} title={e.heading} lead={e.lead(x.books.length)}>
    <p class="note">{e.note}</p>
  </PageHero>
  <div class="cards">
    {x.grades.map(g => <GradeCard href={g.url} img={`g${g.grade}a`} tiny={`GRADE ${g.grade}`} title={`${CN[g.grade]}年级数学`} text={`${g.books.map(b => b.volumeName).join(' · ')} · 单元学习指南`} more="查看课程 →" />)}
  </div>
  <section class="below"><h2>如何使用课程导航？</h2><p>进入对应的年级与上下册，按照单元顺序浏览知识点、课堂难点和活动建议。</p><p><a href="/articles/textbook-edition-guide/">阅读新旧教材版本辨别指南</a></p></section>
</PageLayout>
