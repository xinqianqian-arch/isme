---
/* 全部教材：一个版本的所有册，按年级分组，每册一张卡片；顶部年级标签可以跳到对应年级 */
import PageLayout from '../../../layouts/PageLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CatalogHero from '../../../components/CatalogHero.astro';
import LessonSearch from '../../../components/LessonSearch.astro';
import { getCatalog, CN, type Book } from '../../../lib/catalog';
import { media } from '../../../lib/media.mjs';
import { abs } from '../../../lib/seo';

export async function getStaticPaths() {
  const { editions } = await getCatalog();
  return editions.map(x => ({ params: { edition: x.edition.slug }, props: { x } }));
}
const { x } = Astro.props;
const e = x.edition;
const done = (b: Book) => b.units.reduce((n, u) => n + u.lessons.filter(l => l.indexable).length, 0);
const count = (b: Book) => b.units.reduce((n, u) => n + u.lessons.length, 0);
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${e.name}小学数学课程目录`, url: abs(x.url), inLanguage: 'zh-CN' };
---
<PageLayout title={`${e.name}小学数学1—6年级课件目录与备课指南`} description={`${e.name}小学数学上下册课程导航：分年级查找真实单元目录、教学内容、易错点和互动课件更新。`} jsonLd={[ld]}>
  <Breadcrumb items={[{ name: '教材目录', url: '/textbooks/' }, { name: e.name }]} />
  <CatalogHero eyebrow={`${e.name} · 全部教材`} title={e.heading} lead={e.lead(x.books.length)}>
    <div class="ch-search"><LessonSearch placeholder={`在${e.name}里搜课题或知识点`} /></div>
    <p class="ch-note">{e.note}<a href="/articles/textbook-edition-guide/">如何辨别新旧教材？</a></p>
  </CatalogHero>
  {x.grades.length > 1 && (
    <nav class="gtabs" aria-label="按年级筛选">
      <button type="button" class="on" data-grade="">全部</button>
      {x.grades.map(g => <button type="button" data-grade={g.grade}>{CN[g.grade]}年级</button>)}
    </nav>
  )}
  <div class="bkgrid">
    {x.books.map(b => {
      const n = done(b);
      return (
        <a class="bkcard" href={b.url} data-grade={b.grade} id={b.volume === 1 ? `grade-${b.grade}` : undefined}>
          <span class="bk-pic"><img src={b.cover ?? media(`courseware/covers/g${b.grade}a.webp`)} alt="" loading="lazy"></span>
          <span class="bk-body">
            <span class="bk-top"><strong>{CN[b.grade]}年级{b.volumeName}</strong>{n > 0 && <span class="tag-hot">{n} 课完整备课</span>}</span>
            <span class="bk-meta">{b.units.length} 个单元 · {count(b)} 课</span>
            <span class="bk-units">{b.units.map(u => u.title).join('、')}</span>
            <span class="go">查看全册目录 →</span>
          </span>
        </a>
      );
    })}
  </div>
</PageLayout>

<script>
  /* 年级筛选：点年级只显示这个年级的上下册；网址带 #grade-3 时直接筛到三年级 */
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.gtabs button')];
  const cards = [...document.querySelectorAll<HTMLElement>('.bkgrid .bkcard')];
  const pick = (g: string) => {
    tabs.forEach(t => t.classList.toggle('on', t.dataset.grade === g));
    cards.forEach(c => { c.hidden = !!g && c.dataset.grade !== g; });
  };
  tabs.forEach(t => t.addEventListener('click', () => {
    pick(t.dataset.grade!);
    history.replaceState(null, '', t.dataset.grade ? `#grade-${t.dataset.grade}` : location.pathname);
  }));
  const m = /^#grade-(\d)$/.exec(location.hash);
  if (m) { pick(m[1]); scrollTo(0, 0); }
</script>
