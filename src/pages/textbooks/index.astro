---
/* 找课：搜索框 + 按教材选一册 + 最新完整备课。目标是两步以内找到想要的那一课 */
import PageLayout from '../../layouts/PageLayout.astro';
import LessonSearch from '../../components/LessonSearch.astro';
import BookPicker from '../../components/BookPicker.astro';
import LatestLessons from '../../components/LatestLessons.astro';
import { getCatalog } from '../../lib/catalog';
import { media } from '../../lib/media.mjs';
const { editions, lessons } = await getCatalog();
const done = lessons.filter(l => l.indexable).length;
/** 搜索框下面的示例词，点一下直接搜 */
const hot = ['两、三位数乘一位数', '轴对称', '周长', '三下 除法', '线段、射线、直线'];
---
<PageLayout title="找课：小学数学同步教材目录与逐课备课资源" description={`按课题或知识点搜索，或按教材、年级一页看全册单元和课时。覆盖${editions.map(x => x.edition.name).join('、')}，已有 ${done} 课完整备课：教材解读、教学设计、趣味活动与 AI 互动课件用法。`}>
  <section class="fhero">
    <div class="fh-text">
      <p class="ch-eyebrow">找课 · 已有 {done} 课完整备课</p>
      <h1>小学数学，按课找备课资料</h1>
      <p class="fh-lead">输入课题或知识点直接打开那一课，或先选教材和年级，一页看全册所有课。</p>
      <LessonSearch big readQuery />
      <p class="hot-words"><span>常搜</span>{hot.map(w => <a href={`/textbooks/?q=${encodeURIComponent(w)}`}>{w}</a>)}</p>
    </div>
    <div class="fh-pic"><img src={media('brand/teacher.webp')} alt="十一老师" fetchpriority="high"></div>
  </section>
  {editions.map(x => (
    <section class="find-sec">
      <div class="sec-title">
        <h2>{x.edition.name}<small>{x.edition.card}</small></h2>
        <a href={x.url}>全部目录 →</a>
      </div>
      <BookPicker books={x.books} />
    </section>
  ))}
  <section class="find-sec">
    <div class="sec-title">
      <h2>最新完整备课<small>一课一篇：教材解读、教学设计、趣味活动、AI 提示词</small></h2>
    </div>
    <LatestLessons limit={8} />
  </section>
</PageLayout>
