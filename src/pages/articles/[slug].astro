---
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DocPage from '../../components/DocPage.astro';
import { getArticles, articleUrl, ymd } from '../../lib/articles';
import { article } from '../../lib/seo';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  return (await getArticles()).map(a => ({ params: { slug: a.id }, props: { a } }));
}
const { a } = Astro.props;
const { Content, headings } = await render(a);
const d = a.data;
---
<PageLayout title={d.标题} description={d.简介} type="article"
  jsonLd={[article({ title: d.标题, description: d.简介, url: articleUrl(a.id), date: d.日期, updated: d.更新 })]}>
  <Breadcrumb items={[{ name: '教学文章', url: '/articles/' }, { name: d.大标题 ?? d.标题 }]} />
  <DocPage title={d.大标题 ?? d.标题} kicker="教学文章" icon={d.图标 ?? 'o12'} headings={headings}
    byline={`${SITE.author.name} · ${ymd(d.日期)}${d.更新 ? ` · 更新于 ${ymd(d.更新)}` : ''}`}>
    <Content />
    <aside slot="after" class="doc-cta">
      <p><strong>想看十一课件的互动课件？</strong>原创课件和课堂演示在小红书主页持续更新。</p>
      <a href={SITE.xhs.profile} target="_blank" rel="nofollow noopener noreferrer">去小红书看课件 ↗</a>
    </aside>
  </DocPage>
</PageLayout>
