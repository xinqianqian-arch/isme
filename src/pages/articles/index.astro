---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getArticles, articleUrl } from '../../lib/articles';
const articles = await getArticles();
---
<PageLayout title="小学数学教学文章" description="阅读十一课件原创教学思路、课堂案例和数学知识点解析。">
  <PageHero eyebrow="教学文章" title="数学教学文章" lead="备课思路、课堂案例和教材版本辨别，写给一线小学数学老师。" />
  <div class="cards">
    {articles.map(a => <a class="card" href={articleUrl(a.id)}><h2>{a.data.标题}</h2><p>{a.data.简介}</p></a>)}
  </div>
</PageLayout>
