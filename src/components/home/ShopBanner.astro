---
/* 首页底部的小红书横幅 */
import { media } from '../../lib/media.mjs';
import { SITE } from '../../site.config';
---
<div class="shop">
  <div class="shop-bg"></div>
  <img class="teacher" src={media('brand/teacher.webp')} alt="十一老师">
  <div>
    <h3>原创课件与最新进度，在小红书查看</h3>
    <p>小红书搜「十一课件」· 小红书号 {SITE.xhs.id}</p>
  </div>
  <a class="btn" href={SITE.xhs.profile} target="_blank" rel="noopener">查看小红书主页 →</a>
</div>
