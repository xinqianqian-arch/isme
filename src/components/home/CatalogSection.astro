---
/* 首页「按教材找到下一节课」：六个年级的插画卡片 */
import { media } from '../../lib/media.mjs';
import '../../styles/home-catalog.css';
import { getCatalog, CN } from '../../lib/catalog';
import LessonSearch from '../LessonSearch.astro';
const grades = (await getCatalog()).grades.filter(g => g.edition.slug === 'bsd');
---
<section class="edu-catalog" id="curriculum">
  <div class="wrap">
    <div class="sec-head">
      <h2>按教材找到下一节课 📚</h2>
      <p>输入课题或知识点直接找到那一课，或者按年级、上下册一页看全册目录</p>
    </div>
    <div class="edu-search"><LessonSearch big /></div>
    <div class="edu-grades">
      {grades.map(g => (
        <article class="edu-grade">
          <a class="pic" href={g.url} tabindex="-1" aria-hidden="true"><img src={media(`courseware/covers/g${g.grade}a.webp`)} alt="" loading="lazy"></a>
          <div class="body">
            <span>GRADE {g.grade}</span>
            <h3><a href={g.url}>{CN[g.grade]}年级数学</a></h3>
            <p>按单元查看知识重点与课堂活动</p>
            <div class="vols">{g.books.map(b => <a href={b.url}>{b.volumeName} →</a>)}</div>
          </div>
        </article>
      ))}
    </div>
    <p class="edu-footnote">本站为独立教学网站，并非教材出版社官方网站。</p>
  </div>
</section>
