---
/* 找课页面的页头：左边文字，右边一张插画（单元封面），或者 slot="pic" 放教材封面 */
import '../styles/catalog.css';
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** 右侧插画的完整网址 */
  img?: string;
  as?: 'section' | 'header';
}
const { eyebrow, title, lead, img, as: Tag = 'section' } = Astro.props;
const pic = Astro.slots.has('pic');
---
<Tag class:list={['chero', { 'has-img': !!img, 'has-book': pic }]}>
  <div class="ch-text">
    {eyebrow && <p class="ch-eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="ch-lead">{lead}</p>}
    <slot />
  </div>
  {img && <div class="ch-pic"><img src={img} alt="" fetchpriority="high"></div>}
  {pic && <div class="ch-book"><slot name="pic" /></div>}
</Tag>
