---
pagination:
  data: catalogGrades
  size: 1
  alias: item
permalink: "/textbooks/{{ item.edition }}/grade-{{ item.grade }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ item.name }}{{ item.grade }}年级数学课件"
  description: "{{ item.name }}{{ item.grade }}年级数学上下册同步教学课件资源目录。"
---
<p><a href="/textbooks/{{ item.edition }}/">{{ item.name }}</a> / {{ item.grade }}年级</p><h1>{{ item.name }}{{ item.grade }}年级数学课件</h1><div class="cards">{% for volume in [1,2] %}<a class="card" href="/textbooks/{{ item.edition }}/grade-{{ item.grade }}/volume-{{ volume }}/"><h2>{{ "上册" if volume == 1 else "下册" }}</h2><p>按课时查看已发布课件</p></a>{% endfor %}</div>
